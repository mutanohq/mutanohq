---
import "@fontsource/lilita-one";
import "@fontsource-variable/nunito";
import "@mutano/brand/tokens.css";

interface Props {
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} · Mutano` : "Mutano";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/", label: "Home" },
  { href: "/brand", label: "Brand" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4147CB" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <header class="site-header">
      <a class="home" href="/" aria-label="Mutano home">
        <picture>
          <source srcset="/brand/logo/lockup-white.svg" media="(prefers-color-scheme: dark)" />
          <img src="/brand/logo/lockup.svg" alt="Mutano" width="160" height="34" />
        </picture>
      </a>
      <nav aria-label="Main">
        {
          nav.map(({ href, label }) => (
            <a href={href} aria-current={path === href ? "page" : undefined}>
              {label}
            </a>
          ))
        }
        <a href="https://github.com/mutanohq">GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} Mutano. Code under <a href="https://github.com/mutanohq/mutanohq/blob/main/LICENSE"
          >Apache-2.0</a
        >; the Mutano name and logo follow the <a href="/brand#usage">brand usage rules</a>.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: var(--mutano-paper);
    --surface: var(--mutano-white);
    --text: var(--mutano-ink);
    --muted: var(--mutano-ink-muted);
    --primary: var(--mutano-indigo);
    --line: color-mix(in oklab, var(--mutano-ink) 12%, transparent);
    --font-display: "Lilita One", system-ui, sans-serif;
    --font-body: "Nunito Variable", system-ui, sans-serif;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: var(--mutano-indigo-night);
      --surface: color-mix(in oklab, var(--mutano-indigo-night) 88%, white);
      --text: var(--mutano-paper);
      --muted: var(--mutano-indigo-soft);
      --primary: var(--mutano-indigo-glow);
      --line: color-mix(in oklab, white 14%, transparent);
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 400 1.0625rem/1.6 var(--font-body);
  }
  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 0.5em;
  }
  a {
    color: var(--primary);
  }
  main {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 1rem 4rem;
  }
  .site-header {
    max-width: 68rem;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }
  .site-header .home {
    display: block;
    line-height: 0;
  }
  .site-header nav {
    display: flex;
    gap: 1.25rem;
    font-weight: 700;
  }
  .site-header nav a {
    color: var(--text);
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 3px solid transparent;
  }
  .site-header nav a:hover,
  .site-header nav a[aria-current="page"] {
    border-color: var(--mutano-yuzu);
  }
  :focus-visible {
    outline: 3px solid var(--mutano-yuzu);
    outline-offset: 2px;
  }
  .site-footer {
    max-width: 68rem;
    margin: 0 auto;
    padding: 2rem 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
