---
import tokens from "@mutano/brand/tokens.json";

import Base from "../layouts/base.astro";

const logos = [
  { name: "Lockup", file: "lockup", ratio: "wide" },
  { name: "Mark", file: "mark", ratio: "mark" },
  { name: "Small mark", file: "mark-small", ratio: "mark" },
  { name: "Wordmark", file: "wordmark", ratio: "wide" },
];
const versions = [
  { suffix: "", label: "Color", bg: "paper" },
  { suffix: "-white", label: "White", bg: "indigo" },
  { suffix: "-black", label: "Black", bg: "white" },
];
const icons = [
  ["favicon.svg", "Favicon (SVG)"],
  ["favicon.ico", "Favicon (ICO, 16-48px)"],
  ["app-icon.svg", "App icon (SVG)"],
  ["apple-touch-icon.png", "Apple touch icon (180px)"],
  ["icon-192.png", "Icon (192px)"],
  ["icon-512.png", "Icon (512px)"],
  ["avatar.png", "Avatar (1024px)"],
];
const pngs = ["mark-1024.png", "mark-white-1024.png", "lockup-2048.png", "lockup-white-2048.png"];
const colors = Object.entries(tokens);
const guidelines = "https://github.com/mutanohq/mutanohq/blob/main/docs/guidelines/brand.md";
---

<Base title="Brand" description="The Mutano logo, icons, colors, and fonts, ready to download, with the rules for using them.">
  <h1 class="title">Brand kit</h1>
  <p class="lede">
    Everything you need to show Mutano: logos, icons, colors, and fonts. The <a href={guidelines}>brand guidelines</a>{" "}
    explain each choice.
  </p>

  <section aria-labelledby="logos">
    <h2 id="logos">Logos</h2>
    <div class="grid">
      {
        logos.map(({ name, file, ratio }) => (
          <figure class="card">
            <div class={`swatches ${ratio}`}>
              {versions.map(({ suffix, label, bg }) => (
                <a class="tile" style={`background: var(--mutano-${bg})`} href={`/brand/logo/${file}${suffix}.svg`} download>
                  <img src={`/brand/logo/${file}${suffix}.svg`} alt={`${name}, ${label.toLowerCase()}`} />
                </a>
              ))}
            </div>
            <figcaption>
              {name}: SVG in {versions.map(({ label }) => label.toLowerCase()).join(", ")}. Click one to download it.
            </figcaption>
          </figure>
        ))
      }
    </div>
    <p>
      Need a raster file?{" "}
      {
        pngs.map((file, i) => (
          <>
            {i > 0 && ", "}
            <a href={`/brand/png/${file}`} download>
              {file}
            </a>
          </>
        ))
      }.
    </p>
  </section>

  <section aria-labelledby="icons">
    <h2 id="icons">Icons</h2>
    <ul class="links">
      {
        icons.map(([file, label]) => (
          <li>
            <a href={`/brand/icon/${file}`} download>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="colors">
    <h2 id="colors">Colors</h2>
    <ul class="colors">
      {
        colors.map(([name, { hex, oklch }]) => (
          <li>
            <span class="chip" style={`background: ${hex}`} />
            <strong>{name}</strong>
            <code>{hex}</code>
            <code>{oklch}</code>
          </li>
        ))
      }
    </ul>
    <p>
      As CSS custom properties: <a href="/brand/tokens.css" download>tokens.css</a>. As JSON:{" "}
      <a href="/brand/tokens.json" download>tokens.json</a>.
    </p>
  </section>

  <section aria-labelledby="type">
    <h2 id="type">Typography</h2>
    <div class="grid">
      <div class="card type">
        <p class="sample display">Lilita One</p>
        <p>Headlines and the wordmark. <a href="/brand/fonts/LilitaOne-Regular.ttf" download>Download</a> (SIL OFL 1.1).</p>
      </div>
      <div class="card type">
        <p class="sample body">Nunito</p>
        <p>Body text and interfaces. <a href="/brand/fonts/Nunito[wght].ttf" download>Download</a> (SIL OFL 1.1).</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="usage-title" id="usage">
    <h2 id="usage-title">Usage</h2>
    <p>
      You can use the Mutano logo to link to us or to talk about Mutano and what we make. Please don't use it in a way
      that suggests we made, sponsor, or endorse something we didn't, and don't use it as part of your own logo or
      product name.
    </p>
    <ul>
      <li>Keep clear space around the logo of at least the height of the D-pad.</li>
      <li>Use the small mark when the logo is 48px wide or less.</li>
      <li>Don't recolor, stretch, rotate, outline, or add effects to the logo, and don't retype the wordmark.</li>
      <li>On photos or busy backgrounds, use the white version on a dark area, or the color version on a light one.</li>
    </ul>
    <p>The Mutano name and logo are not covered by the Apache-2.0 license of the code.</p>
  </section>
</Base>

<style>
  .title {
    font-size: clamp(2.5rem, 7vw, 4rem);
    margin-top: 2rem;
  }
  .lede {
    font-size: 1.2rem;
    max-width: 40rem;
  }
  section {
    margin-top: 3.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 1rem;
  }
  .card {
    margin: 0;
    padding: 1rem;
    border-radius: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  .tile {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: 0.75rem;
    border: 1px solid var(--line);
    padding: 0.75rem;
  }
  .tile img {
    width: 100%;
    max-height: 100%;
  }
  .mark .tile img {
    width: 70%;
  }
  figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0;
    list-style: none;
  }
  .colors {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: 0.75rem;
  }
  .colors li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 0.75rem;
    align-items: center;
  }
  .chip {
    grid-row: span 3;
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    border: 1px solid var(--line);
  }
  code {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .sample {
    font-size: 2.5rem;
    margin: 0;
    line-height: 1.2;
  }
  .display {
    font-family: var(--font-display);
  }
  .body {
    font-family: var(--font-body);
    font-weight: 700;
  }
</style>
